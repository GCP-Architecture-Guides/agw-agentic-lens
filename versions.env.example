# Agentic Lens — Global Configuration
# Copy this file to versions.env and fill in your values.

PROJECT_ID=YOUR_PROJECT_ID
REGION=us-east1

# Numeric organization ID (required for Agent Identity IAM)
# gcloud projects describe YOUR_PROJECT_ID --format='value(parent)' → organizations/YOUR_ORG_ID
ORG_ID=YOUR_ORG_ID

ADK_VERSION=1.18
MODEL_VERSION=gemini-2.5-pro

# --- Agent Gateway (required for governed access) ---
AGENT_GATEWAY_INGRESS=projects/YOUR_PROJECT_NUMBER/locations/us-east1/agentGateways/your-prefix-ingress-gateway
AGENT_GATEWAY_EGRESS=projects/YOUR_PROJECT_NUMBER/locations/us-east1/agentGateways/your-prefix-egress-gateway

# --- CMEK (optional — fill after key creation) ---
# AGENT_ENGINE_KMS_KEY_SUPERVISOR=projects/PROJECT_NUMBER/locations/REGION/keyRings/.../cryptoKeys/...
